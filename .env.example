# Server-side only — used by api/contact.ts (Vercel serverless function).
# Do NOT prefix these with VITE_, or they would be bundled into client code.

# Resend API key used to send contact form emails: https://resend.com
# This is the only variable that must be set — the form works out of the
# box once it's set, using the defaults below.
RESEND_API_KEY=

# Address(es) the contact form notification email is sent to.
# Comma-separate multiple recipients. Defaults to
# "mail@aibooking.dk,kontakt@aibooking.dk" when unset.
CONTACT_EMAIL_TO=

# Sender address. Defaults to Resend's built-in sandbox sender
# ("Aibooking.dk <onboarding@resend.dev>"), which works with no domain
# verification. Set this to your own verified domain in Resend once you
# have one, for better deliverability and branding.
CONTACT_EMAIL_FROM=
