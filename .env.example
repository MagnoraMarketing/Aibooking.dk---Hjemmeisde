# Server-side only — used by api/contact.ts (Vercel serverless function).
# Do NOT prefix these with VITE_, or they would be bundled into client code.

# Resend API key used to send contact form emails: https://resend.com
RESEND_API_KEY=

# Address the contact form notification email is sent to
CONTACT_EMAIL_TO=

# Verified sender address/domain in Resend
CONTACT_EMAIL_FROM=
